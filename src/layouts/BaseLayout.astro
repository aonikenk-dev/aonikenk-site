---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import data from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = `${data.site.name}${data.site.tld} — ${data.site.tagline}`,
  description = 'Full Stack Development & Design studio from Patagonia, Argentina. Custom software, branding and web design.',
  lang = 'es',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Set theme before paint to avoid flash -->
  <script is:inline>
    (function () {
      var saved = localStorage.getItem('aonikenk-theme');
      var theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon"             href="/favicon.ico" sizes="48x48" />
  <link rel="icon"             href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- Global styles -->
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap');
  </style>
</head>
<body data-lang={lang}>

  <!-- Custom cursor: sienna triangle + glacier dot, echoes the isotipo -->
  <div id="cur">
    <svg viewBox="0 0 24 26" width="24" height="26" fill="none">
      <g transform="rotate(-16 12 13)">
        <polygon points="12,2 19,17 5,17" fill="var(--sienna)" stroke="rgba(20,15,10,.35)" stroke-width="0.6" stroke-linejoin="round"/>
        <circle cx="12" cy="21.5" r="2.4" fill="var(--ice)"/>
      </g>
    </svg>
  </div>

  <!-- Shared nav -->
  <Nav />

  <!-- Page content -->
  <slot />

  <!-- Shared footer -->
  <Footer />

  <Analytics />

  <!-- Boot all JS modules -->
  <script>
    import { initCursor  } from '../scripts/cursor.js';
    import { initLang    } from '../scripts/i18n.js';
    import { initSplash  } from '../scripts/splash.js';
    import { initReveal  } from '../scripts/reveal.js';
    import { initTheme   } from '../scripts/theme.js';
    import { initContact } from '../scripts/contact.js';

    initCursor();
    initLang();
    initSplash();
    initReveal();
    initTheme();
    initContact();
  </script>

</body>
</html>

<style lang="scss" is:global>
  @use '../styles/main.scss';
</style>
