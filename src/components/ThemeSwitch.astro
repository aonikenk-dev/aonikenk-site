---
// No props — state is managed by theme.js
---
<button class="theme-switch" data-theme-toggle aria-label="Toggle light/dark theme">
  <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4.5"/>
    <line x1="12" y1="2.5" x2="12" y2="5"/>
    <line x1="12" y1="19" x2="12" y2="21.5"/>
    <line x1="4.2" y1="4.2" x2="6" y2="6"/>
    <line x1="18" y1="18" x2="19.8" y2="19.8"/>
    <line x1="2.5" y1="12" x2="5" y2="12"/>
    <line x1="19" y1="12" x2="21.5" y2="12"/>
    <line x1="4.2" y1="19.8" x2="6" y2="18"/>
    <line x1="18" y1="6" x2="19.8" y2="4.2"/>
  </svg>
  <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.6 6.6 0 0 0 10.5 10.5Z"/>
  </svg>
</button>
