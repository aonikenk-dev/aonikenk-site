---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import data from '../../data/site.json';

// ── Static paths — one page per project ──────────────────────
export function getStaticPaths() {
  return data.projects.map(p => ({
    params: { slug: p.slug },
    props:  { project: p },
  }));
}

